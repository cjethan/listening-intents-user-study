enum PlayInstrument {
  yes
  ongoing
  no
}

enum FormalEducation {
  yes
  ongoing
  no
}

enum ComposeMusic {
  yes
  no
  occasionally
}

enum InstrumentYears {
  less_than_1_year
  _1_2_years
  _3_5_years
  _6_10_years
  more_than_10_years
}

model UserResult {
  user_id                String   @id
  prolific_id           String
  play_instrument       PlayInstrument
  formal_education      FormalEducation
  compose_music         ComposeMusic
  hours_listening_weekly Int      
  instruments_played_years InstrumentYears?

  instruments           UserInstrument[]
  intents               Intent[]
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users UserGenre[]
}

model UserGenre {
  user_id String
  genre_id Int

  user  UserResult @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  genre Genre      @relation(fields: [genre_id], references: [id], onDelete: Cascade)

  @@id([user_id, genre_id])
}

model Instrument {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users UserInstrument[]
}

model UserInstrument {
  user_id      String
  instrument_id Int

  user       UserResult  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  instrument Instrument  @relation(fields: [instrument_id], references: [id], onDelete: Cascade)

  @@id([user_id, instrument_id])
}

model Adjective {
  id    Int    @id @default(autoincrement())
  word  String @unique
  intents IntentAdjective[]
}

model Intent {
  id         Int      @id @default(autoincrement())
  user_id    String
  name       String
  how_often  String?
  how_imp    String?

  user       UserResult       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  adjectives IntentAdjective[]
  songs      IntentSong[]
}

model IntentAdjective {
  intent_id     Int
  adjective_id  Int

  intent     Intent    @relation(fields: [intent_id], references: [id], onDelete: Cascade)
  adjective  Adjective @relation(fields: [adjective_id], references: [id], onDelete: Cascade)

  @@id([intent_id, adjective_id])
}

model IntentSong {
  id          Int    @id @default(autoincrement())
  intent_id   Int

  track_id    String?
  artist_name String?
  track_uri   String?
  artist_uri  String?
  track_name  String?
  album_uri   String?
  duration_ms Int?
  album_name  String?

  intent      Intent  @relation(fields: [intent_id], references: [id], onDelete: Cascade)
}
